#!/usr/bin/env bash
# Starts, stops, or restarts a background process that writes to /tmp/my_process.

PID_FILE="/var/run/my_process.pid"

run_process() {
    while true
    do
        echo "I am alive!" >> /tmp/my_process
        sleep 2
    done
}

case "$1" in
    start)
        run_process &
        echo $! > "$PID_FILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")"
            rm -f "$PID_FILE"
        fi
        echo "manage_my_process stopped"
        ;;
    restart)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")"
            rm -f "$PID_FILE"
        fi
        run_process &
        echo $! > "$PID_FILE"
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac